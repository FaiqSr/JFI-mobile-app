{
  "cli": {
    "version": ">= 22.2.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://jfi.faiqsr.my.id/api/auth",
        "EXPO_PUBLIC_CS_BASE_URL": "https://jfi.faiqsr.my.id/api/cs",
        "EXPO_PUBLIC_PRODUCTION_BASE_URL": "https://jfi.faiqsr.my.id/api/produksi"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://jfi.faiqsr.my.id/api/auth",
        "EXPO_PUBLIC_CS_BASE_URL": "https://jfi.faiqsr.my.id/api/cs",
        "EXPO_PUBLIC_PRODUCTION_BASE_URL": "https://jfi.faiqsr.my.id/api/produksi"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://jfi.faiqsr.my.id/api/auth",
        "EXPO_PUBLIC_CS_BASE_URL": "https://jfi.faiqsr.my.id/api/cs",
        "EXPO_PUBLIC_PRODUCTION_BASE_URL": "https://jfi.faiqsr.my.id/api/produksi"
      }
    }
  },
  "submit": {
    "production": {}
  }
}